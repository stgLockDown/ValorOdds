# ─────────────────────────────────────────────────────────────
# Valor Odds Web — Environment Variables
# Copy this file to .env.local for local development.
# On Railway, set these in the service's Variables tab.
# ─────────────────────────────────────────────────────────────

# ---------- App ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Valor Odds

# ---------- Database (shared with Discord bot) ----------
# Railway Postgres connection string
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ---------- NextAuth / Auth.js ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-random-32-bytes
NEXTAUTH_URL=http://localhost:3000

# ---------- Discord OAuth ----------
# Create app at https://discord.com/developers/applications
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Guild ID where roles get assigned (Valor Odds & Sports server)
DISCORD_GUILD_ID=
# Role IDs for tier sync
DISCORD_ROLE_PREMIUM=
DISCORD_ROLE_VIP=

# ---------- Internal API (Next.js <-> Discord bot) ----------
# Any long random string, must match value set on the bot side
INTERNAL_API_KEY=replace-me-with-random-long-string
# Base URL of the bot's HTTP server
BOT_API_BASE_URL=https://valoroddsdiscordbot-production.up.railway.app

# ---------- Stripe ----------
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# Created when you add a webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Product IDs (from Stripe Dashboard)
STRIPE_PRODUCT_BASIC=
STRIPE_PRODUCT_PREMIUM=prod_UPYSeWPotixwU2
STRIPE_PRODUCT_VIP=prod_UPYWwtSNL1LAqR

# ---------- Resend (transactional email) ----------
# https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Valor Odds <noreply@valorodds.com>"

# ---------- Admin ----------
# Comma-separated list of web_user emails that get admin access
ADMIN_EMAILS=you@example.com